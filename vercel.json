{
  "crons": [
    {
      "path": "/api/v1/cron/daily-summary",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/v1/cron/weekly-summary",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/v1/cron/visit-closures-digest",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/v1/cron/rotate-qr-code",
      "schedule": "0 5 * * *"
    }
  ],
  "installCommand": "npm install --legacy-peer-deps"
}